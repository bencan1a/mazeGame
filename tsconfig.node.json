{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    // scripts/ ships plain .mjs so the Actions runner can execute it without a
    // build; allowJs lets its tests typecheck against the real implementation.
    "allowJs": true,
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "eslint.config.js", "scripts"]
}
